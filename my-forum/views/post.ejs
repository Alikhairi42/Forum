<%- include('partials/header') %>

<div class="post-detail">
    <!-- Post Header -->
    <div class="post-header">
        <h1><%= post.title %></h1>
        <div class="post-meta">
            <span>👤 <%= post.username %></span>
            <span>📅 <%= new Date(post.created_at).toLocaleDateString() %></span>
            <span>🕒 <%= new Date(post.created_at).toLocaleTimeString() %></span>
        </div>
    </div>

    <!-- Post Content -->
    <div class="post-content">
        <%= post.content %>
    </div>

    <!-- Reactions -->
    <div class="reactions">
        <button 
            class="reaction-btn <%= userReaction === 'like' ? 'active' : '' %>" 
            onclick="react(<%= post.id %>, 'post', 'like')"
            id="like-btn"
        >
            👍 Like (<span id="like-count"><%= post.likes %></span>)
        </button>
        <button 
            class="reaction-btn <%= userReaction === 'dislike' ? 'active' : '' %>" 
            onclick="react(<%= post.id %>, 'post', 'dislike')"
            id="dislike-btn"
        >
            👎 Dislike (<span id="dislike-count"><%= post.dislikes %></span>)
        </button>
    </div>

    <!-- Delete button (if owner) -->
    <% if (user && user.id === post.user_id) { %>
        <form action="/posts/<%= post.id %>/delete" method="POST" style="margin-top: 1rem;">
            <button type="submit" class="btn-delete" onclick="return confirm('Delete this post?')">
                🗑️ Delete Post
            </button>
        </form>
    <% } %>

    <!-- Comments Section -->
    <div class="comments-section">
        <h2>💬 Comments (<%= comments.length %>)</h2>

        <!-- Add Comment Form (if logged in) -->
        <% if (user) { %>
            <form action="/comments" method="POST" class="comment-form">
                <input type="hidden" name="post_id" value="<%= post.id %>">
                <textarea 
                    name="content" 
                    placeholder="Write a comment..." 
                    required
                    rows="3"
                ></textarea>
                <button type="submit" class="btn">💬 Post Comment</button>
            </form>
        <% } else { %>
            <p class="login-prompt">
                <a href="/auth/login">Login</a> to comment
            </p>
        <% } %>

        <!-- Comments List -->
        <div class="comments-list">
            <% if (comments.length > 0) { %>
                <% comments.forEach(comment => { %>
                    <div class="comment" id="comment-<%= comment.id %>">
                        <div class="comment-header">
                            <strong>👤 <%= comment.username %></strong>
                            <span class="comment-date">
                                <%= new Date(comment.created_at).toLocaleDateString() %>
                            </span>
                        </div>
                        <div class="comment-content">
                            <%= comment.content %>
                        </div>
                        <div class="comment-reactions">
                            <button 
                                class="reaction-btn-small" 
                                onclick="react(<%= comment.id %>, 'comment', 'like')"
                            >
                                👍 <span id="comment-like-<%= comment.id %>"><%= comment.likes %></span>
                            </button>
                            <button 
                                class="reaction-btn-small" 
                                onclick="react(<%= comment.id %>, 'comment', 'dislike')"
                            >
                                👎 <span id="comment-dislike-<%= comment.id %>"><%= comment.dislikes %></span>
                            </button>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p class="no-comments">No comments yet. Be the first!</p>
            <% } %>
        </div>
    </div>

    <p style="margin-top: 2rem;">
        <a href="/">← Back to Home</a>
    </p>
</div>

<%- include('partials/footer') %>